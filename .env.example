# Default provider: free, local, no key required.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b,llama3.2:3b

# Free cloud fallbacks (only if you switch LLM_PROVIDER):
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant,llama-3.3-70b-versatile

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Paid (best quality, optional):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

USD_TO_INR=83
REUSE_THRESHOLD=0.85
STARTUP_MIN_RAISE_USD=15000000
