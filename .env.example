# Copy to .env (git-ignored) and fill in. Never commit .env.

# LLM provider, or a comma-separated fallback chain tried in order.
# Local-only (nothing leaves your machine):   LLM_PROVIDER=ollama
# Groq first, local fallback:                 LLM_PROVIDER=groq,ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b,llama3.2:3b

# Groq (free tier) — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low          # reasoning models only: low | medium | high

# Gemini (optional)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic (optional, paid)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Job-board API keys (optional; connectors skip themselves when absent)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# RAPIDAPI_KEY=                      # JSearch
# HIMALAYAS_API_KEY=                 # optional: raises limits to 60/min, 10k/day

# Tuning
USD_TO_INR=83
REUSE_THRESHOLD=0.85
STARTUP_MIN_RAISE_USD=15000000
# WORKDAY_DETAIL_DELAY_SEC=0.7
# WORKDAY_DETAIL_MAX=60
# JOBCOPILOT_DB=data/jobcopilot.db
